{
  "name": "nolane-video-remotion",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic minimalist H2 character animation rendered with Remotion.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts OneMoreScroll out/one-more-scroll.mp4 --codec=h264 --concurrency=2",
    "still": "remotion still src/index.ts OneMoreScroll out/preview.png --frame=180"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
